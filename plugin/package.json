{
  "name": "@stream-deck-herdr/plugin",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.sogaani.herdr\"",
    "validate": "streamdeck validate com.sogaani.herdr.sdPlugin",
    "pack": "streamdeck pack com.sogaani.herdr.sdPlugin --output ../dist --force",
    "check-bundle": "rollup -c scripts/bundle-check.rollup.mjs --environment OUT:../dist/herdr-client-bundle-check.mjs && BUNDLE=../dist/herdr-client-bundle-check.mjs node scripts/bundle-check.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2",
    "@elgato/utils": "^0.6.1",
    "@stream-deck-herdr/herdr-client": "*"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "rollup": "^4.30.0",
    "tslib": "^2.8.0"
  }
}
